# Application Port & Environment
PORT=5000
NODE_ENV=production

# Public Base URLs
BASE_URL=https://your-production-domain.com
# Multiple frontend origins can be comma-separated: https://app.domain.com,https://domain.com
FRONTEND_URL=https://your-frontend-app.com

# Database Connection (Option 1: Cloud Connection String - Recommended for Railway, Render, Supabase, Neon)
# DATABASE_URL=postgres://username:password@host:5432/database_name

# Database Connection (Option 2: Individual Parameters)
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=postgres
DB_PASSWORD=your_strong_db_password_here
DB_NAME=url_shortener
# Set to true for remote cloud databases requiring SSL (Railway, Supabase, Neon)
DB_SSL=false

# Database Connection Pooling (Production Tuning)
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6385
REDIS_PASSWORD=

# JWT Authentication Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_64_character_random_hex_string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_64_character_random_hex_string
JWT_REFRESH_EXPIRATION=7d

# Master Admin Credentials
ADMIN_EMAIL=admin@zelnk.local
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Super Admin
